{
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnSave": true
  },
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua"
  },
  "editor.formatOnSave": true,
  "Lua.misc.executablePath": "/etc/profiles/per-user/ali/bin/lua-language-server",
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "eval": {},
      "formatting": {
        "command": [
          "nixfmt"
        ]
      },
      "nixpkgs": {
        "expr": "(builtins.getFlake \"path:${workspaceFolder}\").nixosConfigurations.nixosvm.pkgs"
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"path:${workspaceFolder}\").nixosConfigurations.nixosvm.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"path:${workspaceFolder}\").nixosConfigurations.nixosvm.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  }
}
